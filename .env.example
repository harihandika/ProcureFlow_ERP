# Copy to .env in the repository root. Never commit the filled .env file.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=procureflow_erp
JWT_SECRET=
AI_SERVICE_API_KEY=

# Browser-facing URLs; change to your HTTPS domains when using a reverse proxy.
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Leave both empty until you choose a supported Gemini model and obtain its key.
GEMINI_API_KEY=
GEMINI_MODEL=

# Docker ports bind only to localhost unless you explicitly change these.
WEB_BIND_IP=127.0.0.1
API_BIND_IP=127.0.0.1
